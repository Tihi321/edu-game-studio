{
  "name": "edu-game-studio",
  "version": "0.0.1",
  "private": true,
  "description": "Edu Studio: turns a topic into a playable educational game",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build:player": "vite build --config vite.player.config.ts --logLevel warn",
    "build:live": "vite build --config vite.live.config.ts --logLevel warn",
    "build:engine": "yarn build:player && yarn build:live && vite build --config vite.engine.config.ts --logLevel warn",
    "dev": "yarn build:engine && electron-vite dev",
    "build": "yarn build:engine && electron-vite build",
    "engine": "yarn build:engine && node out/engine/index.js",
    "mcp": "yarn build:engine && node out/engine/index.js --mcp-only",
    "key:set": "yarn build:engine && node out/engine/index.js key-set",
    "play": "node scripts/play.mjs",
    "studio:shots": "node scripts/studio-shots.mjs",
    "previews": "node scripts/theme-previews.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "yarn test && yarn test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.player.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.0",
    "chokidar": "^4.0.3",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "author": "Tihomir Selak"
}
